# GitHub App / PAT with permissions:
# - contents: write (for git operations)
# - security-events: read (for Dependabot alerts, used by sla-tracker)
# - metadata: read
SECURITY_PAT=

# Repository owner (optional, defaults to current repo)
REPO_OWNER=

# Repository name (optional, defaults to current repo)
REPO_NAME=

# SLA threshold in business days (default: 1) — passado como argumento de CLI
# para sla-tracker.ts, não lido diretamente do ambiente.
SLA_BUSINESS_DAYS=1

# Enable debug logging
DEBUG=false
