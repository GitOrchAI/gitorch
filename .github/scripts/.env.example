# GitHub App / PAT with permissions:
# - contents: write (for git operations, PR merges)
# - issues: write (for creating issues, comments)
# - pull-requests: write (for PR comments, labels, auto-merge)
# - security-events: read (for Dependabot alerts)
# - actions: read (for CI logs)
# - metadata: read
SECURITY_PAT=

# OpenRouter API key for free models
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Jules API key (from https://jules.google.com/settings)
JULES_API_KEY=

# Repository owner (optional, defaults to current repo)
REPO_OWNER=

# Repository name (optional, defaults to current repo)
REPO_NAME=

# Free model to use (must end with :free)
# Options: qwen/qwen-2.5-7b-instruct:free, nousresearch/hermes-3-llama-3.1-8b:free, google/gemma-2-9b-it:free, microsoft/phi-3-mini-128k-instruct:free
OPENROUTER_FREE_MODEL=qwen/qwen-2.5-7b-instruct:free

# SLA threshold in business days (default: 1)
SLA_BUSINESS_DAYS=1

# Delay between issue creations in milliseconds (default: 5min = 300000)
ISSUE_CREATION_DELAY_MS=300000

# Delay after issue creation before adding label in milliseconds (default: 10s = 10000)
LABEL_DELAY_MS=10000

# Enable debug logging
DEBUG=false