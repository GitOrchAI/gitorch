#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🧪 Iniciando Validações Estritas de Pre-Commit (Tolerância Zero)..."

echo "1/3 🧹 Executando Linting (0 Avisos permitidos)"
pnpm exec lint-staged

echo "2/3 🏗️ Executando Typechecking (0 Any permitidos)"
pnpm run typecheck:strict

echo "3/3 🎯 Executando Testes (100% de cobertura)"
pnpm run test

echo "✅ Tudo limpo! Commit autorizado."
