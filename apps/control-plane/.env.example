# GitOrch Control Plane Environment Variables
# Copy to .env and fill in values

# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
LOG_PRETTY=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://gitorch:gitorch@localhost:5432/gitorch

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Produção atrás do Funnel (F2): ligar trustProxy e ZERAR o allowlist.
# GITORCH_TRUST_PROXY=1
# GITORCH_RATE_LIMIT_ALLOWLIST=

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub App (instalação com seleção de repos — routes/github-app-install.ts)
# GITHUB_APP_ID e GITHUB_APP_PRIVATE_KEY já existem acima de outro fluxo
# (github-app-token.ts, usado pelos trilhos PO/QA/SM). GITHUB_APP_SLUG é
# NOVO: o slug público do App (a parte depois de github.com/apps/), usado só
# para montar o link `https://github.com/apps/<slug>/installations/new`.
# PASSO MANUAL no GitHub (dono do App, github.com/settings/apps/<app>):
#   1. Copie o slug da URL das configurações do App e cole aqui.
#   2. Em "Setup URL", cadastre <GITORCH_PUBLIC_URL>/api/v1/auth/github/install/callback
#      e marque "Redirect on update" se quiser reprocessar reinstalações.
#   3. Em "Permissions", confirme "Repository permissions > Contents: Read"
#      (mínimo para clonar) — sem isso a instalação não lista repositórios.
GITHUB_APP_SLUG=gitorch-ai

# JWT (for F10 OAuth)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h

# API Keys (for F8 auth)
API_KEY_PREFIX=gitorch

# Prisma
PRISMA_QUERY_ENGINE_LIBRARY=1

# Telegram (opcional — sem isto o passo do wizard simplesmente não conecta nada)
# O bot é criado no @BotFather. O control-plane OUVE o bot por long-polling
# (getUpdates), então NÃO é preciso URL pública: funciona atrás de NAT, no
# self-host. Cada instalação deve usar o SEU bot — dois processos ouvindo o mesmo
# bot brigam pelos updates (a API devolve 409 e nós logamos isso).
GITORCH_TELEGRAM_BOT_TOKEN=123456:ABC-seu-token-do-BotFather
# @username do bot, sem o @ (é o que monta o deep link t.me/<bot>?start=<token>).
GITORCH_TELEGRAM_BOT_USERNAME=SeuBot_bot
# Chat de OPERAÇÃO da instalação: usado só para avisos sobre os projetos do
# próprio dono da instância (GITORCH_OWNER_EMAIL). Evento de cliente NUNCA cai
# aqui — vai para o chat que o próprio cliente vinculou no wizard.
GITORCH_TELEGRAM_CHAT_ID=-1001234567890
GITORCH_OWNER_EMAIL=voce@example.com
# Stripe billing (test: pk_test/sk_test | live: pk_live/sk_live)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Limites de execução por missão (scheduler + wizard) — opcionais, sem eles o
# comportamento é o de sempre (sem teto de CPU/memória, 1 missão simultânea).
# Teto de missões simultâneas na VM: cobre TANTO a cadência (RA/PO/SM/QA)
# QUANTO o provisionamento do wizard (clone_and_start_engines). Default do
# código é 1 (seguro pra qualquer instalação); nesta VM dev (ARM 4CPU/11GB) o
# valor recomendado é 2 — cabe confortavelmente com o teto de memória abaixo.
GITORCH_MAX_CONCURRENT=2
# Aplica cgroup transitório (systemd-run --scope) por execução de agente:
# 'systemd' liga o wrapper (só entra em vigor se o binário systemd-run
# existir no PATH; sem ele, degrada pro comando cru em vez de falhar a
# missão). Qualquer outro valor, inclusive ausente, roda sem teto (default).
GITORCH_EXEC_LIMITS=systemd
GITORCH_EXEC_MEMORY_MAX=2G
GITORCH_EXEC_CPU_QUOTA=150%

# ATENÇÃO — SÓ PARA CI/E2E. NUNCA defina isto num deploy real.
# GITORCH_FAKE_ENGINES=1 troca o login assistido e a liveness dos 3 motores
# (Claude/Codex/Antigravity) por fakes determinísticos no boot: login
# "conecta" instantâneo sem container/podman, liveness sempre viva com
# modelos/quota fixos (ver services/fake-engines.ts). Existe para o E2E do
# funil completo do setup wizard rodar em TODO PR sem imagem de agente, CLIs
# reais nem credencial de provider nenhuma
# (tests/e2e/setup-wizard-funil-completo-fake.spec.ts). Default é OFF; mesmo
# que setado por engano, fakeEnginesEnabled() recusa quando NODE_ENV=production.
# GITORCH_FAKE_ENGINES=1
# Sobrescreve a cadência do tick do scheduler (default 60000ms) — usado junto
# com GITORCH_FAKE_ENGINES=1 no CI para a missão clone_and_start_engines não
# esperar até 1 minuto pra processar num teste automatizado.
# GITORCH_SCHEDULER_TICK_MS=2000

# Manifesto de versões dos motores (ponte público↔privado — services/version-manifest.ts)
# O control-plane (repo público) não fixa a versão do Claude/Codex/Antigravity
# nem a referência dos pacotes nativos (cadence/cgc/memória) no código — isso
# vive num manifesto de versões mantido fora deste repositório, em infra
# privada. GITORCH_MANIFEST_PATH aponta pro caminho LOCAL desse arquivo (ver
# a memória/infra do seu projeto para onde ele está); sem a env var,
# loadManifest() lança erro claro — nunca inventa versão nenhuma. Exemplo:
# GITORCH_MANIFEST_PATH=/caminho/para/manifest.json

# Bootstrap de recursos versionados no ambiente do cliente (infra privada —
# ClientEnvironmentService.bootstrapResources, W1.2.2). Script que, após o
# aceite final do wizard, INSTALA dentro do ambiente isolado de cada cliente
# os motores/recursos pinados do MESMO manifesto que GITORCH_MANIFEST_PATH lê
# (acima) e grava <ambiente>/.gitorch/env-lock.json — auditável, é o que vira
# ClientEnvironment.resourcesLock. Sem a env var, bootstrapResources() falha
# com uma causa clara (o ambiente vira 'error') — nunca finge que instalou.
# Exemplo (ver a memória/infra do seu projeto para o caminho local real):
# GITORCH_BOOTSTRAP_SCRIPT=/caminho/para/bootstrap-env.sh
# Teto de tempo do script (ms). Default 600000 (10min) cobre a 1ª instalação
# de uma versão nova (npm install); reinstalações do mesmo cache são segundos.
# GITORCH_BOOTSTRAP_TIMEOUT_MS=600000
