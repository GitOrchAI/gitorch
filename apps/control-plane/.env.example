# GitOrch Control Plane Environment Variables
# Copy to .env and fill in values

# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
LOG_PRETTY=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://gitorch:gitorch@localhost:5432/gitorch

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub OAuth App — LOGIN de usuário do wizard (flow OAuth em src/routes/auth.ts,
# GET /api/v1/auth/github). SEPARADO do GitHub App "gitorch-ai" (GITHUB_APP_ID/
# GITHUB_APP_PRIVATE_KEY), que é para automação/webhooks/token de missão.
# Sem estes, o login quebra com 500: {"error":"GITHUB_CLIENT_ID is not configured"}.
# Não remover na faxina do .env achando que a migração pro GitHub App os dispensa.
GITHUB_CLIENT_ID=your-oauth-app-client-id-here
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret-here

# JWT (for F10 OAuth)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h

# API Keys (for F8 auth)
API_KEY_PREFIX=gitorch

# Prisma
PRISMA_QUERY_ENGINE_LIBRARY=1
# Stripe billing (test: pk_test/sk_test | live: pk_live/sk_live)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
