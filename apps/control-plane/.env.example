# GitOrch Control Plane Environment Variables
# Copy to .env and fill in values

# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
LOG_PRETTY=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://gitorch:gitorch@localhost:5432/gitorch

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# JWT (for F10 OAuth)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h

# API Keys (for F8 auth)
API_KEY_PREFIX=gitorch

# Prisma
PRISMA_QUERY_ENGINE_LIBRARY=1