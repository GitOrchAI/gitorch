generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenant: a pessoa/conta dona de N projetos. As credenciais de motor são do
// usuário (EngineConnection) e herdadas por todos os projetos dele.
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  githubLogin String?  @unique @map("github_login")
  // Âncora de identidade estável do GitHub (o `login` pode ser renomeado ou
  // reusado por outra conta depois que o dono original o abandona — sem esta
  // coluna, um upsert por githubLogin faria um usuário NOVO "herdar" o User
  // antigo de quem já teve aquele username, um takeover silencioso). BigInt
  // porque o id numérico do GitHub já ultrapassa o range de um Int de 32 bits
  // para contas mais recentes.
  githubId    BigInt?  @unique @map("github_id")
  // Instalação do GitHub App (gitorch) que este usuário concedeu, escolhida
  // por ELE na tela de instalação do GitHub — não confundir com
  // Project.githubInstallationId (a instalação vinculada a um repositório
  // específico, usada pelo webhook). Esta aqui é por USUÁRIO: com ela,
  // GET /api/v1/github/repos passa a listar só os repos que a pessoa
  // realmente autorizou, em vez do escopo amplo do OAuth App clássico.
  githubInstallationId Int? @map("github_installation_id")
  isActive    Boolean  @default(true) @map("is_active")

  planId      String   @default("free") @map("plan_id")
  plan        Plan     @relation(fields: [planId], references: [id])

  stripeCustomerId String? @unique @map("stripe_customer_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects          Project[]
  engineConnections EngineConnection[]
  subscription      Subscription?
  diagnosisJobs     DiagnosisJob[]
  environments      ClientEnvironment[]
  telegramLink      TelegramLink?

  @@map("users")
}

// Vínculo do Telegram do CLIENTE — o que torna o aviso possível.
//
// FATO DA API DO TELEGRAM: um bot só consegue mandar mensagem para quem já
// falou com ele, e `sendMessage` exige um `chat_id` (numérico). Um @username de
// pessoa NÃO endereça ninguém. Por isso o passo do wizard que só guardava o
// @username era incapaz de funcionar por construção: dado write-only.
//
// O caminho real (padrão do Telegram) é o deep link com token: geramos um token
// de uso único, o cliente abre `t.me/<bot>?start=<token>` e aperta Start; o bot
// recebe `/start <token>` e é NESSE update que o `chat_id` finalmente existe —
// aí sim ele é vinculado ao dono do token.
model TelegramLink {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // pending (deep link gerado, esperando o Start) | linked (chat_id capturado).
  // Nunca há um terceiro estado "achamos que deu certo" — o wizard mostra
  // exatamente um destes dois.
  status String @default("pending")

  // Token que viaja no deep link e volta pra nós no /start. É de USO ÚNICO
  // (consumido no vínculo, vira NULL) e EXPIRA: sem isso, quem visse o link uma
  // vez poderia apontar as notificações do dono para o próprio chat.
  token          String?   @unique
  tokenExpiresAt DateTime? @map("token_expires_at")

  // Só existe DEPOIS do Start. É ele que a API do Telegram exige para enviar.
  chatId   String?   @map("chat_id")
  linkedAt DateTime? @map("linked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("telegram_links")
}

// Plano é dado configurável (limites), não código. Valores/precificação são
// definidos fora do schema; aqui vivem apenas os limites operacionais.
model Plan {
  id                String  @id
  name              String
  maxProjects       Int     @map("max_projects")
  maxMissionsPerDay Int     @map("max_missions_per_day")
  isActive          Boolean @default(true) @map("is_active")

  // Escalonamento de missões: tierRank ordena a fila (maior = mais prioridade);
  // maxConcurrentMissions é o teto de missões simultâneas do dono nesse plano.
  tierRank              Int @default(0) @map("tier_rank")
  maxConcurrentMissions Int @default(1) @map("max_concurrent_missions")
  seats                 Int @default(1)

  // Direitos de feature por plano (autonomia auto, sensores, fila prioritária).
  // JSON pra evoluir sem migração a cada flag nova. Lido pelo entitlements can().
  features Json @default("{}")

  users  User[]
  prices PlanPrice[]

  @@map("plans")
}

// Preço de um plano por FAIXA de poder de compra (A rica / B emergente / C
// land-grab) e moeda. O stripePriceId aponta pro Price object criado no Stripe.
// Fonte da verdade do /pricing; preço no Stripe é imutável (reajuste = novo Price).
model PlanPrice {
  id           String @id @default(cuid())
  planId       String @map("plan_id")
  plan         Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  tier          String // A | B | C
  currency      String // usd | brl
  unitAmount    Int    @map("unit_amount") // em centavos
  stripePriceId String @map("stripe_price_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([planId, tier])
  @@map("plan_prices")
}

// Assinatura Stripe do usuário. Espelho local atualizado pelos webhooks; o
// User.planId é derivado daqui. Uma assinatura ativa por usuário.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String @unique @map("stripe_subscription_id")
  planId               String @map("plan_id")
  tier                 String // faixa cobrada (A/B/C)
  status               String @default("incomplete") // active | past_due | canceled | incomplete
  currentPeriodEnd     DateTime? @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

// Lista de espera: cap de capacidade da infra atual (~10-20 pagantes ativos).
// Acima do teto, novos pagantes entram aqui em vez de assinar.
model Waitlist {
  id             String  @id @default(cuid())
  email          String  @unique
  githubLogin    String? @map("github_login")
  requestedPlanId String? @map("requested_plan_id")
  tier           String?
  country        String?
  status         String  @default("waiting") // waiting | invited | converted

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("waitlist")
}

// Conexão OAuth de um motor (runtime) pertencente ao usuário. A credencial é
// armazenada cifrada (nunca em texto puro) e montada apenas no ambiente
// isolado das missões do próprio usuário.
model EngineConnection {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runtime String // ex.: antigravity | codex | claude
  // pending | connected | error | revoked | awaiting_approval | expired |
  // stale | needs_reconnect. Só "connected" após validação real (ping
  // autenticado) — nunca fachada (spec setup-wizard-redesign §17.3/§17.4).
  status  String @default("pending")

  encryptedCredential   String?   @map("encrypted_credential")
  // 'file' (padrão): a credencial é um arquivo restaurado no HOME da missão
  // (ex.: .codex/auth.json, .gemini/.../antigravity-oauth-token).
  // 'env': a credencial é um valor único injetado como variável de ambiente
  // (ex.: Claude Code — CLAUDE_CODE_OAUTH_TOKEN — não existe como arquivo).
  credentialKind        String?   @default("file") @map("credential_kind")
  envVarName            String?   @map("env_var_name")
  expiresAt             DateTime? @map("expires_at")
  // Renovação automática do token do GitHub (F8): o login por GitHub App
  // expira o access_token a cada ~8h quando "User-to-server token
  // expiration" está ligado, e devolve um refresh_token junto. Cifrado com o
  // MESMO envelope AES-256-GCM de encryptedCredential — nunca texto puro.
  // NULL em toda conexão feita ANTES desta coluna existir (legado): a
  // rotina de renovação trata a ausência como "precisa reconectar uma vez",
  // nunca como "não expira".
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  models                Json? // catálogo de modelos descoberto no provider
  modelsRefreshedAt     DateTime? @map("models_refreshed_at")
  lastValidatedAt       DateTime? @map("last_validated_at")
  /// Ate quando esta conta esta RESERVADA para uma renovacao em curso.
  ///
  /// O refresh token de alguns provedores e de USO UNICO: quem usa recebe um
  /// novo e o antigo morre na hora. Com tres caminhos nossos capazes de
  /// renovar a mesma conta (a vigia de hora em hora, a captura depois de cada
  /// missao, e o login assistido), duas renovacoes simultaneas fazem a segunda
  /// usar um token ja queimado — e a conta do cliente cai por culpa nossa.
  /// Medido em 26/08 com o codex: "Your refresh token has already been used".
  ///
  /// E uma DATA, e nao um booleano, para a trava se soltar sozinha: um
  /// processo que morre no meio da renovacao nao pode deixar a conta travada
  /// para sempre.
  renewalLockedUntil    DateTime? @map("renewal_locked_until")
  lastError             String?   @map("last_error")

  // Quota restante do provider (BYOK), lida best-effort junto com os modelos.
  // Alimenta o spend-guard: quota crítica bloqueia a missão (protege a conta do
  // cliente de estourar). null = provider não expõe / desconhecido.
  quotaRemaining   Int?      @map("quota_remaining")
  quotaTotal       Int?      @map("quota_total")
  quotaRefreshedAt DateTime? @map("quota_refreshed_at")

  // Claude (`claude -p "/usage"`, ver quota-reader.ts): a CLI não expõe um
  // saldo remaining/total — devolve % USADO de DUAS janelas independentes
  // (sessão ~5h corridas e semana, todos os modelos) + o horário de reset de
  // cada uma. Colunas novas e só o runtime 'claude' as popula; Codex/
  // Antigravity continuam só em quotaRemaining/quotaTotal acima.
  sessionPercentUsed Int?    @map("session_percent_used")
  sessionResetsAt    String? @map("session_resets_at")
  weekPercentUsed    Int?    @map("week_percent_used")
  weekResetsAt       String? @map("week_resets_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, runtime])
  @@map("engine_connections")
}

model Project {
  id          String   @id @default(cuid())
  // "owner/repo" — o endereço do REPOSITÓRIO (o scheduler clona a partir dele e
  // o webhook casa `repository.full_name` contra ele), NÃO a chave do tenant.
  // Por isso NÃO é único global: dois clientes podem, legitimamente, cadastrar o
  // mesmo repo (dois colaboradores de "acme/api"). O único global fazia o
  // segundo cliente ACHAR o Project do primeiro no wizard e receber uma ApiKey
  // válida sobre o projeto alheio. A unicidade é por DONO (@@unique abaixo).
  wingId      String   @map("wing_id")
  name        String
  description String?
  avatarUrl   String?  @map("avatar_url")
  defaultBranch String @default("main") @map("default_branch")
  isActive    Boolean  @default(true) @map("is_active")

  // Nulo apenas para registros legados; todo projeto novo nasce com dono.
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])

  runtimeConfig Json?    @map("runtime_config")

  // Plano do dev assíncrono declarado pelo dono: 'free' | 'pro' | 'ultra'.
  // A API do serviço não oferece consulta de cota, então o teto é declarado.
  devPlan String? @map("dev_plan")

  githubInstallationId Int?   @unique @map("github_installation_id")
  githubRepoId        BigInt? @unique @map("github_repo_id")

  // Credencial do PRÓPRIO cliente, cifrada. Existe porque a credencial do
  // produto não alcança quadro de conta pessoal nem rota de segurança nenhuma:
  // é usada só onde o App não chega, nunca como atalho geral.
  encryptedClientToken String? @map("encrypted_client_token")

  // BYOK (D34): a conta do dev assíncrono DO CLIENTE, cifrada com a mesma
  // chave e o mesmo caminho das credenciais dos motores de IA. Ausente = este
  // projeto usa a conta da instância (a do dono) e divide o teto dela.
  encryptedDevApiKey String? @map("encrypted_dev_api_key")
  // A impressão digital da conta acima — NUNCA o segredo. É por ela que o
  // produto soma o teto dos projetos do MESMO cliente sem precisar decifrar
  // credencial nenhuma para contar (services/credencial-do-dev-do-cliente.ts).
  devAccountId       String? @map("dev_account_id")

  // D50: o aviso de publicação do CD do cliente.
  //
  // `deployNoticeInstalledAt` é a PROVA de que a chamada existe e funciona —
  // gravado na primeira vez que um aviso chega pela rota. Vem do comportamento
  // real, não de uma intenção registrada, e por isso vale mais que qualquer
  // marca nossa.
  // `deployNoticeAskedKey` é o dedup do PEDIDO: sem ele o produto abriria uma
  // issue por tique no repositório do cliente.
  deployNoticeInstalledAt DateTime? @map("deploy_notice_installed_at")
  deployNoticeAskedKey    String?   @map("deploy_notice_asked_key")

  // Reconferência PERIÓDICA do acesso do dono ao repositório (o acesso era
  // provado uma vez, no cadastro, e o caminho automático nunca mais perguntava
  // nada — ver services/reconferencia-de-acesso.ts).
  // Nulo = nunca conferido: entra no primeiro ciclo depois do deploy.
  accessCheckedAt   DateTime? @map("access_checked_at")
  // Preenchido = projeto SUSPENSO: não dispara missão até o acesso voltar.
  accessSuspendedAt DateTime? @map("access_suspended_at")
  accessSuspendedReason String? @map("access_suspended_reason")
  // Conferências seguidas que não concluíram nada. NUNCA suspendem — só
  // encurtam o intervalo da próxima tentativa e, no limite, avisam o dono.
  accessCheckFailures Int @default(0) @map("access_check_failures")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  missions    Mission[]
  events      Event[]
  apiKeys     ApiKey[]
  webhookDeliveries WebhookDelivery[]
  schedules   ProjectSchedule[]
  agentQuestions AgentQuestion[]
  devSessions DevSession[]

  // Um repo, um projeto, POR DONO. É o banco garantindo o que a rota de setup
  // passou a exigir — mesmo repo em dois clientes = dois projetos distintos.
  // (Legado sem dono: no Postgres NULLs são distintos entre si, então linhas
  // órfãs antigas não colidem; projeto novo nunca nasce sem dono.)
  @@unique([userId, wingId])
  // Mantido: é por ele que o webhook do GitHub reencontra o projeto pelo
  // full_name do repositório (o wizard não preenche os ids numéricos).
  @@index([wingId])
  @@index([userId])
  @@index([devAccountId])
  @@map("projects")
}

// Agenda de execução por projeto e por agente (cron). Substitui a agenda
// fixa em código: o scheduler lê daqui a cada ciclo.
model ProjectSchedule {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agentRole String  @map("agent_role") // po | ra | sm | qa
  cron      String // expressão cron de 5 campos
  isActive  Boolean @default(true) @map("is_active")

  lastTriggeredAt DateTime? @map("last_triggered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId, agentRole])
  @@index([isActive])
  @@map("project_schedules")
}

model Mission {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type        String
  status      String   @default("pending")
  payload     Json
  result      Json?
  error       String?

  // Consumo da missão no LLM do cliente (BYOK), medido por diferença de quota:
  // quotaBefore (antes de disparar) − quotaAfter (após concluir) = tokensUsed.
  // null quando o provider não expõe quota. Somado por período no spend-guard.
  quotaBefore Int?      @map("quota_before")
  quotaAfter  Int?      @map("quota_after")
  tokensUsed  Int?      @map("tokens_used")

  waitingStatus String? @map("waiting_status")
  waitingReason String? @map("waiting_reason")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([projectId, type])
  @@map("missions")
}

model Event {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      String
  payload   Json
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([type])
  @@map("events")
}

model ApiKey {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  keyHash   String   @unique @map("key_hash")
  prefix    String   @unique
  scopes    String[] @default(["read"])
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("api_keys")
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  githubDeliveryId String @unique @map("github_delivery_id")
  eventType     String   @map("event_type")
  action        String?
  payload       Json
  processed     Boolean  @default(false)
  processingError String? @map("processing_error")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([processed])
  @@map("webhook_deliveries")
}

// Diagnóstico grátis do setup wizard (F1) — ZERO-LLM, roda ANTES de criar um
// Project (a pessoa ainda não escolheu plano/pagou). Por isso é seu próprio
// modelo, não uma Mission: não conta contra limite de projeto, não tem custo
// de LLM/quota, e existe fora do ciclo de vida de um Project.
model DiagnosisJob {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  repoFullName String    @map("repo_full_name")
  status       String    @default("pending") // pending|running|completed|failed
  progress     String?   // último passo narrado: cloning|indexing|reading_github|done
  result       Json?
  error        String?
  // Cache do grafo 3D (GET /:id/graph): o export reprocessa o CGC do zero
  // (~7-8s) — sem isto, toda 2ª carga da tela (ou reload) pagava o custo de
  // novo. Preenchido no 1º export bem-sucedido; nulo até lá / se o export
  // falhar (não cacheia ausência, só sucesso).
  graph        Json?

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  completedAt  DateTime? @map("completed_at")

  @@index([userId, repoFullName])
  @@map("diagnosis_jobs")
}

// Ambiente isolado do cliente, provisionado passo a passo pelo setup wizard.
// Nasce 'provisional' no aceite dos termos (passo 3), acumula o clone dos
// repos (passo 4) e as credenciais de motor logadas DENTRO dele (passo 7), e
// vira 'fixed' no aceite final (passo 10), quando o contexto do repo é
// coletado pra memória. Um garbage collector destrói ambientes 'provisional'
// SEM ATIVIDADE há 24h — requisito de SEGURANÇA, não higiene: o diretório guarda
// credenciais + OAuth do cliente e não pode ficar largado se ele abandona.
model ClientEnvironment {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SÓ o ciclo de vida do wizard: 'provisional' (durante o wizard) | 'fixed'
  // (aceite final concluído, passo 10). Filtrado por fix()/createProvisional()/
  // listExpired() — todos tratam 'provisional' como "ainda no wizard, sujeito
  // à faxina de 24h". NUNCA MAIS escrito pelo bootstrap de recursos (ver
  // `resourcesStatus` abaixo): antes desta coluna existir, os dois papéis
  // dividiam este MESMO campo, e um ambiente cujo bootstrap rodasse ANTES do
  // submit (ex.: no clone, passo 4/5) saía de 'provisional' NO MEIO do wizard
  // — fix() parava de reconhecê-lo (nunca fixava) e listExpired() (a faxina
  // que apaga ambiente abandonado com credencial) parava de enxergá-lo
  // (vazamento real). Correção de timing: branch fix/w1-bootstrap-timing.
  status String @default("provisional")
  // Diretório isolado em disco onde o clone + as credenciais do cliente vivem.
  path   String

  // Progresso do bootstrap de recursos, DESACOPLADO do ciclo de vida acima:
  // null (bootstrap não rodou ainda) -> 'provisioning' -> 'ready'/'error'.
  // Existe porque o bootstrap dispara cedo — no CLONE (passo 4/5) — bem antes
  // do aceite final (passo 10); se ele escrevesse em `status` (como antes),
  // um ambiente ainda em pleno wizard virava 'ready'/'error' e quebrava o
  // ciclo de vida acima (ver o comentário de `status`). Ver
  // ClientEnvironmentService.bootstrapResources para a máquina de estados e
  // o guard de reentrância (a função pode ser chamada 2x: clone-time e
  // submit-time como salvaguarda).
  resourcesStatus String? @map("resources_status")

  // Versões REALMENTE instaladas pelo bootstrap (infra/bootstrap-env.sh) DENTRO
  // do ambiente — o mesmo conteúdo do <env>/.gitorch/env-lock.json gerado por
  // ele (motores versionados + commit dos recursos nativos do manifesto).
  // Auditável, exibido ao dono no painel/StepReady. null enquanto o bootstrap
  // não rodou ainda ou falhou (ver ClientEnvironmentService.bootstrapResources)
  // — nunca inventa uma versão instalada.
  resourcesLock Json? @map("resources_lock")

  fixedAt   DateTime? @map("fixed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // O relógio da faxina: última ATIVIDADE REAL do cliente neste ambiente
  // (aceitar termos, clonar repo, iniciar/concluir login de motor). O TTL mede
  // INATIVIDADE, não idade — cortando por `createdAt`, quem aceitava os termos,
  // conectava os motores e voltava pra terminar o wizard depois de 24h tinha o
  // ambiente destruído NO MEIO do cadastro, junto com o clone e as credenciais.
  //
  // É coluna PRÓPRIA, e não o `updatedAt`: o @updatedAt sobe a QUALQUER escrita
  // na linha, então um backfill/manutenção ressuscitaria em massa ambientes
  // abandonados cheios de credencial. A renovação tem que ser um ato explícito
  // e auditável (ClientEnvironmentService.touch), nunca um efeito colateral.
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  // status+lastActivityAt: é o corte exato que o garbage collector faz.
  @@index([userId])
  @@index([status, lastActivityAt])
  @@map("client_environments")
}

// Dúvida registrada por um agente (human-in-the-loop, épico W3) — fonte ÚNICA
// consumida pelo painel E pelo Telegram. Quando um agente esbarra numa decisão
// de rumo NÃO documentada (ex.: 3 páginas com cores diferentes — "qual a cor
// oficial?"), ele registra aqui em vez de travar: o dono responde (painel ou,
// nesta fase, só Telegram — ver docs/superpowers/specs/2026-07-21-w3-telegram-
// duvidas-design.md) e a resposta vira memória (Cortex), então o agente nunca
// mais pergunta a mesma coisa (ver AgentQuestionService.ask, dedupKey).
model AgentQuestion {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // O DONO do projeto — não necessariamente quem clicou (só o dono responde
  // hoje); é por ele que a notificação acha o chat_id certo (TelegramLink).
  userId String @map("user_id")

  text    String
  // Evidência/onde a dúvida se encaixa (ex.: os 3 arquivos com cores
  // divergentes) — opcional, só contexto para o dono decidir.
  context String?

  // Array de {label, value} — cada item vira um botão no Telegram
  // (callback_data referencia o ÍNDICE, não o value — ver W3.3). Vazio =
  // pergunta aberta (o dono responde em texto livre).
  options Json @default("[]")

  // dedupKey normaliza a pergunta (ex.: "cor-oficial-site"): se já existe uma
  // AgentQuestion 'answered' do MESMO projeto com a mesma chave, ask() devolve
  // a decisão já tomada em vez de perguntar de novo — é o contrato central
  // do human-in-the-loop (o dono não quer ser perguntado 2x a mesma coisa).
  dedupKey String? @map("dedup_key")

  // open (aguardando) | answered (o dono decidiu) | expired (reservado para
  // política futura de TTL — não usado nesta fase).
  status String @default("open")

  answer      String?   // o value escolhido (ou o texto livre da resposta aberta)
  answeredAt  DateTime? @map("answered_at")
  answeredVia String?   @map("answered_via") // telegram | panel

  // Id da mensagem enviada no Telegram — permite editar/confirmar depois do
  // clique (ex.: "✓ Respondido: <label>"). Nulo até a notificação sair.
  telegramMessageId Int? @map("telegram_message_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // O painel lista "abertas primeiro" por projeto — filtro quente.
  @@index([projectId, status])
  // ask() busca por dedupKey (escopado ao projeto na query, não aqui) antes
  // de criar — chave de busca quente, não única (dedupKey pode repetir entre
  // projetos e entre uma pergunta aberta e a respondida antiga).
  @@index([dedupKey])
  @@map("agent_questions")
}
/// A ligação entre a issue, a sessão do dev assíncrono e o PR que ela produz.
/// Existe porque essa ligação vivia só no texto de saída da missão e evaporava
/// com o log — e sem ela o PR entregue nunca era reconhecido para julgamento.
model DevSession {
  id          String @id @default(cuid())
  projectId   String @map("project_id")
  issueNumber Int    @map("issue_number")

  /// Identificador da sessão no serviço do dev assíncrono ("sessions/<id>").
  sessionName String @unique @map("session_name")

  state          String    @default("QUEUED")
  stateCheckedAt DateTime? @map("state_checked_at")
  /// Última vez que a sessão deu sinal de avanço. É o que separa "trabalhando"
  /// de "parada": a API não tem estado para isso e não oferece retomada.
  lastProgressAt DateTime? @map("last_progress_at")

  /// Hash da última pergunta já respondida, para não responder duas vezes
  /// enquanto o dev ainda processa a resposta anterior.
  answeredHash String? @map("answered_hash")

  /// Só o NÚMERO. A URL vem de serviço externo e nunca é desreferenciada.
  pullRequestNumber Int? @map("pull_request_number")

  /// Tetos, para nada girar para sempre gastando cota.
  attempts Int @default(1)
  nudges   Int @default(0)

  /// Preenchidos quando a linha sai da vigia: merged, abandoned ou failed_final.
  closedAt     DateTime? @map("closed_at")
  closedReason String?   @map("closed_reason")

  /// Data de criação da demanda (issue) e data do merge real (PR).
  wishCreatedAt DateTime? @map("wish_created_at")
  mergedAt      DateTime? @map("merged_at")

  /// Desde quando esta entrega está com a verificação automática pendente —
  /// nulo enquanto nunca esteve, ou depois que o juiz limpa a marca ao
  /// julgar. É a partir dela que `decidirSobreVerificacao`
  /// (vigia-da-verificacao.ts) conta o teto de espera antes de avisar o dono.
  pendingSince DateTime? @map("pending_since")
  /// SHA do commit de fato mesclado — a Tarefa 12 usa para casar a execução
  /// de CD com a entrega certa (nunca declarar publicado um commit antigo).
  mergeCommitSha String? @map("merge_commit_sha")
  /// Último estado de publicação lido no ambiente do cliente (Tarefa 13).
  deployState String? @map("deploy_state")
  /// Quando `deployState` foi lido pela última vez (Tarefa 13).
  deployCheckedAt DateTime? @map("deploy_checked_at")
  /// Fracassos SEGUIDOS de mescla contra o commit atual (Tarefa 10) — zera
  /// quando o commit muda. Não usado por esta migração, só criado por ela.
  mergeFailures Int @default(0) @map("merge_failures") @db.SmallInt
  /// Quando o último fracasso de mescla aconteceu (Tarefa 10).
  mergeLastFailedAt DateTime? @map("merge_last_failed_at")
  /// Marca da tarefa de conserto já aberta para esta sessão
  /// (`gitorch:conserto:<origem>:<commit>`) — o dedup que impede a vigília de
  /// abrir uma issue por tique no repositório do cliente.
  deployFixKey String? @map("deploy_fix_key")
  /// O pedido de retrabalho que o QA emitiu e que NÃO chegou ao dev — guardado
  /// inteiro, porque reentregar recado vazio não faz ninguém retrabalhar.
  reworkNoticePending String? @map("rework_notice_pending")
  /// Quantas vezes já tentamos reentregar esse pedido. Tem teto: um serviço
  /// fora do ar não pode virar laço infinito.
  reworkNoticeAttempts Int @default(0) @map("rework_notice_attempts") @db.SmallInt
  /// Veredito da última leitura do ambiente publicado — só existe para exigir
  /// repetição antes de abrir tarefa por ambiente inalcançável.
  envLastVerdict String? @map("env_last_verdict")
  /// BYOK (D34): a conta do dev assíncrono que ABRIU esta sessão. Fica na
  /// linha, e não só no projeto, porque a conta do projeto muda (o cliente
  /// conecta, troca ou desconecta a dele) e a sessão continua existindo lá
  /// fora na conta antiga: consultar, avisar ou arquivar com a chave da conta
  /// nova volta 404 e a vaga fica presa na conta que a pessoa paga. É também
  /// o que faz o teto contar certo — sessão aberta na conta do dono não pode
  /// consumir o teto novo do cliente, nem o contrário.
  /// Nulo = aberta pela conta da instância (todas as sessões anteriores ao BYOK).
  devAccountId String? @map("dev_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  /// Sem índices aqui de propósito: os dois que esta tabela usa
  /// (dev_sessions_open_idx e o único parcial dev_sessions_open_per_issue)
  /// são PARCIAIS (WHERE closed_at IS NULL) e vivem só em
  /// prisma/dev-session-migration.sql — o Prisma não representa índice
  /// parcial sem preview feature. Declarar `@@index([closedAt])` aqui criaria
  /// um índice full-table REDUNDANTE em cima do parcial no baseline de banco
  /// virgem (scripts/db-migrate.sh via `prisma migrate diff --from-empty`),
  /// puro custo em todo insert/update para sempre.
  ///
  /// O de conta é a exceção, e por isso fica: ele NÃO é parcial (a contagem do
  /// teto precisa das linhas fechadas também, porque a janela de 24h conta a
  /// sessão pelo início dela), então não há índice parcial para duplicar.
  @@index([devAccountId])
  @@map("dev_sessions")
}

/// O pedido de desejo que ficou ESPERANDO o dono dizer a qual projeto ele
/// pertence. Existe porque a escolha agora é um BOTÃO no Telegram: entre a
/// pergunta e o toque passa tempo de gente, e o serviço reinicia várias vezes
/// por dia. Guardar isso na memória do processo faria o pedido evaporar antes
/// do clique — a pessoa tocaria no botão e receberia silêncio.
model PedidoDeDesejoPendente {
  id String @id @default(cuid())

  /// O dono que escreveu o pedido. A lista de projetos do botão é recalculada
  /// por ele no momento do clique — nunca congelada aqui, senão um projeto
  /// removido no meio do caminho ainda apareceria como opção válida.
  userId String @map("user_id")

  /// A conversa onde responder. É o mesmo id da pessoa no privado, que é o
  /// único lugar onde o /desejo é aceito.
  chatId String @map("chat_id")

  /// O pedido em linguagem de gente, exatamente como foi escrito. É isto que
  /// não pode se perder: sem ele, o clique no botão não tem o que registrar.
  texto String

  /// Nulo enquanto espera. Preenchido no instante em que o pedido vira issue,
  /// para que uma reentrega do mesmo clique pelo Telegram não abra duas.
  usadoEm DateTime? @map("usado_em")

  createdAt DateTime @default(now()) @map("created_at")

  /// A busca quente é "o pendente deste dono nesta conversa", e a varredura de
  /// vencidos anda por data.
  @@index([userId, chatId])
  @@index([createdAt])
  @@map("pedidos_de_desejo_pendentes")
}
