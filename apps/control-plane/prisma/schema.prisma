generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenant: a pessoa/conta dona de N projetos. As credenciais de motor são do
// usuário (EngineConnection) e herdadas por todos os projetos dele.
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  githubLogin String?  @unique @map("github_login")
  isActive    Boolean  @default(true) @map("is_active")

  planId      String   @default("free") @map("plan_id")
  plan        Plan     @relation(fields: [planId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects          Project[]
  engineConnections EngineConnection[]

  @@map("users")
}

// Plano é dado configurável (limites), não código. Valores/precificação são
// definidos fora do schema; aqui vivem apenas os limites operacionais.
model Plan {
  id                String  @id
  name              String
  maxProjects       Int     @map("max_projects")
  maxMissionsPerDay Int     @map("max_missions_per_day")
  isActive          Boolean @default(true) @map("is_active")

  users User[]

  @@map("plans")
}

// Conexão OAuth de um motor (runtime) pertencente ao usuário. A credencial é
// armazenada cifrada (nunca em texto puro) e montada apenas no ambiente
// isolado das missões do próprio usuário.
model EngineConnection {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runtime String // ex.: antigravity | codex | claude
  status  String @default("pending") // pending | connected | error | revoked

  encryptedCredential String? @map("encrypted_credential")
  models              Json? // catálogo de modelos descoberto no provider
  modelsRefreshedAt   DateTime? @map("models_refreshed_at")
  lastValidatedAt     DateTime? @map("last_validated_at")
  lastError           String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, runtime])
  @@map("engine_connections")
}

model Project {
  id          String   @id @default(cuid())
  wingId      String   @unique @map("wing_id")
  name        String
  description String?
  avatarUrl   String?  @map("avatar_url")
  defaultBranch String @default("main") @map("default_branch")
  isActive    Boolean  @default(true) @map("is_active")

  // Nulo apenas para registros legados; todo projeto novo nasce com dono.
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])

  runtimeConfig Json?    @map("runtime_config")

  githubInstallationId Int?   @unique @map("github_installation_id")
  githubRepoId        BigInt? @unique @map("github_repo_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  missions    Mission[]
  events      Event[]
  apiKeys     ApiKey[]
  webhookDeliveries WebhookDelivery[]
  schedules   ProjectSchedule[]

  @@index([wingId])
  @@index([userId])
  @@map("projects")
}

// Agenda de execução por projeto e por agente (cron). Substitui a agenda
// fixa em código: o scheduler lê daqui a cada ciclo.
model ProjectSchedule {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agentRole String  @map("agent_role") // po | ra | sm | qa
  cron      String // expressão cron de 5 campos
  isActive  Boolean @default(true) @map("is_active")

  lastTriggeredAt DateTime? @map("last_triggered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId, agentRole])
  @@index([isActive])
  @@map("project_schedules")
}

model Mission {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type        String
  status      String   @default("pending")
  payload     Json
  result      Json?
  error       String?

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([projectId, type])
  @@map("missions")
}

model Event {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      String
  payload   Json
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([type])
  @@map("events")
}

model ApiKey {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  keyHash   String   @unique @map("key_hash")
  prefix    String   @unique
  scopes    String[] @default(["read"])
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("api_keys")
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  githubDeliveryId String @unique @map("github_delivery_id")
  eventType     String   @map("event_type")
  action        String?
  payload       Json
  processed     Boolean  @default(false)
  processingError String? @map("processing_error")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([processed])
  @@map("webhook_deliveries")
}