{
  "name": "gitorch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "runtime/*",
    "db"
  ],
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck:strict": "pnpm exec tsx scripts/ci/run-typecheck-strict.ts",
    "audit:cgc": "pnpm exec tsx scripts/ci/run-cgc-audit.ts",
    "audit:readme-parity": "pnpm exec tsx scripts/ci/readme-code-parity.ts",
    "audit:secrets": "pnpm exec tsx scripts/ci/secret-scan.ts",
    "e2e": "pnpm exec tsx scripts/ci/e2e-playwright.ts",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@sourcegraph/scip-typescript": "0.4.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "tsx": "4.22.4",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "fastify-sse-v2": "^4.0.0",
    "minimatch": "10.2.5",
    "prom-client": "^15.1.3",
    "supermemory": "^4.24.12",
    "tar": "^7.5.16"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.16",
      "tar-fs": "^3.1.2",
      "tar-stream": "^3.2.0",
      "minimatch": "10.2.5",
      "@types/node": "20.10.0"
    },
    "patchedDependencies": {
      "tar@7.5.16": "patches/tar@7.5.16.patch"
    }
  }
}
