{
  "name": "gitorch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "runtime/*",
    "db"
  ],
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck:strict": "pnpm exec tsx scripts/ci/run-typecheck-strict.ts",
    "audit:cgc": "pnpm exec tsx scripts/ci/run-cgc-audit.ts",
    "audit:readme-parity": "pnpm exec tsx scripts/ci/readme-code-parity.ts",
    "audit:secrets": "pnpm exec tsx scripts/ci/secret-scan.ts",
    "e2e": "pnpm exec tsx scripts/ci/e2e-playwright.ts",
    "dev": "turbo run dev --parallel",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@prisma/client": "^5.0.0",
    "@sourcegraph/scip-typescript": "0.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.4.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-prometheus": "0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify-plugin": "^6.0.0",
    "fastify-sse-v2": "^4.0.0",
    "minimatch": "10.2.6",
    "prom-client": "^15.1.3",
    "supermemory": "^4.25.3",
    "tar": "^7.5.21"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "find-my-way": "9.7.0",
      "@hono/node-server": "2.0.11",
      "@opentelemetry/auto-instrumentations-node": "0.79.0",
      "@opentelemetry/core": "^2.8.0",
      "@opentelemetry/exporter-prometheus": "0.221.0",
      "@opentelemetry/instrumentation": "0.219.0",
      "@opentelemetry/sdk-node": "0.221.0",
      "@types/node": "26.1.2",
      "fastify": "5.9.0",
      "import-in-the-middle": "3.2.0",
      "minimatch": "10.2.6",
      "postcss": "8.5.18",
      "vite": "8.1.5",
      "tar": "7.5.21",
      "tar-fs": "^3.1.2",
      "tar-stream": "^3.2.0",
      "uuid": "11.1.1",
      "launch-editor": "2.14.1",
      "protobufjs": "7.6.5",
      "fast-uri@^3.0.0": "3.1.4",
      "fast-uri@^4.0.0": "4.1.1"
    },
    "patchedDependencies": {
      "tar@7.5.21": "patches/tar@7.5.21.patch"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,mjs}": [
      "eslint --max-warnings 0"
    ]
  }
}