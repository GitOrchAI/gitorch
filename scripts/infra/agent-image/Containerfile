# Imagem de execução das missões dos agentes.
# Contém apenas o necessário para um CLI de agente analisar um repositório:
# git + Node.js + os CLIs dos motores. Nenhum segredo é embutido na imagem —
# credenciais entram por montagem no ambiente isolado de cada missão.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl ripgrep \
  && rm -rf /var/lib/apt/lists/*

# Motores instalados da fonte oficial (npm): Codex e Claude Code CLIs.
RUN npm install -g @openai/codex @anthropic-ai/claude-code && npm cache clean --force

# MCP servers POR PAPEL (pinados; baixados no build, ZERO download em runtime).
# O entrypoint filtra por GITORCH_AGENT_ROLE quais ficam ativos por missão.
#  - github-mcp-server (Go estatico, oficial): ferramentas do GitHub para PO/SM/QA.
#  - context7 (npm, sem chave): docs de bibliotecas para o RA.
# Perplexity e CGC-vivo ficam para F5 (cookies/kuzu-nativo). Versoes pinadas.
RUN set -eux; \
  case "$(uname -m)" in \
    aarch64) GHMCP_ARCH=arm64 ;; \
    x86_64)  GHMCP_ARCH=x86_64 ;; \
    *) echo "arch nao suportada para github-mcp-server: $(uname -m)" >&2; exit 1 ;; \
  esac; \
  curl -fsSL -o /tmp/ghmcp.tar.gz \
    "https://github.com/github/github-mcp-server/releases/download/v1.5.0/github-mcp-server_Linux_${GHMCP_ARCH}.tar.gz"; \
  tar -xzf /tmp/ghmcp.tar.gz -C /usr/local/bin github-mcp-server; \
  chmod +x /usr/local/bin/github-mcp-server; \
  rm /tmp/ghmcp.tar.gz
RUN npm install -g @upstash/context7-mcp@3.2.2 && npm cache clean --force

# Motor principal (Antigravity CLI) — binário copiado pelo script de build
# (build-agent-image.sh) a partir da instalação do host, na arquitetura certa.
COPY agy /usr/local/bin/agy
RUN chmod 755 /usr/local/bin/agy

# HOME do agente fica FORA do workspace (montado como tmpfs em runtime): caches
# e tokens que o CLI grava no HOME não vazam para o repositório clonado.
RUN mkdir -p /home/agent && chmod 777 /home/agent
ENV HOME=/home/agent

# Plugin nativo do GitOrch (identidade/segurança via rules + hooks de gate de
# shell e convergência). O entrypoint o instala no HOME do agy em runtime.
COPY plugin /opt/gitorch-plugin

# Entrypoint copia as credenciais montadas (read-only) para o HOME gravável.
COPY entrypoint.sh /usr/local/bin/gitorch-entrypoint.sh
RUN chmod 755 /usr/local/bin/gitorch-entrypoint.sh

# Diretório neutro de trabalho; o workspace real é montado em /workspace.
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/gitorch-entrypoint.sh"]
