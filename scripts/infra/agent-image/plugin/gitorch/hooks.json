{
  "gitorch-command-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node hooks/gate-command.js", "timeout": 10 }
        ]
      }
    ]
  },
  "gitorch-read-gate": {
    "PreToolUse": [
      {
        "matcher": "view_file|list_dir",
        "hooks": [
          { "type": "command", "command": "node hooks/gate-read.js", "timeout": 10 }
        ]
      }
    ]
  },
  "gitorch-converge": {
    "PostInvocation": [
      { "type": "command", "command": "node hooks/converge.js", "timeout": 10 }
    ]
  }
}
