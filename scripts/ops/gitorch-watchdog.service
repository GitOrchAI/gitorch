[Unit]
Description=GitOrch Watchdog (missoes travadas, restarts, heartbeat)
Documentation=https://github.com/loureng/gitorch

[Service]
Type=oneshot
User=ubuntu
# Ajuste para o caminho absoluto do checkout no seu host.
ExecStart=/opt/gitorch/scripts/ops/gitorch-watchdog.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gitorch-watchdog
