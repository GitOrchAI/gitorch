[Unit]
Description=GitOrch Watchdog (missoes travadas, restarts, heartbeat)
Documentation=https://github.com/loureng/gitorch

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/projects/gitorch/scripts/ops/gitorch-watchdog.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gitorch-watchdog
